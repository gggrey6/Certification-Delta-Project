#this is where I'm testing the relationships between variables, so anything below this comment will be related to that#

#I will first be testing the relationship between hourly earnings and having a certification. I just want to see the general relationship at first and then will add CLASSWKR after. I'm also only using one year of data for now just to see if any relationship between variables even exists, this is only a starting point.  

cps2016$HOURWAGE2[cps2016$HOURWAGE2 == 999.99] <- NA
cps2016$cert2 <- as.numeric(cps2016$PROFCERT == 2) #I created cert2 the variable because PROFCERT is inherently a category variable, so when PROFCERT equals 2 that means the indvidiual has a certificate 

gen_earnings_relationship <- lm(HOURWAGE2 ~ cert2, data = cps2016)
summary(gen_earnings_relationship)

#Now I'm going to see the relationship between different classes of workers and having a certificate, 
#I converted CLASSWKR into a factor to help with future stats tests as CLASSWKR is actually a categorical variable. 
cps2016$HOURWAGE2[cps2016$HOURWAGE2 == 999.99] <- NA #because anything above 999.9 is NIU (Not in universe)

model_with <- lm(HOURWAGE2 ~ cert2 + CLASSWKR, data = cps2016)
model_without <- update(model_with, . ~ . - CLASSWKR)

anova(model_without, model_with)

#I want to see if WKSTAT might be significant to the conversation or not
cps2016$WKSTAT <- as.factor(cps2016$WKSTAT)
model_with_wkstat <- lm(HOURWAGE2 ~ cert2 + CLASSWKR + WKSTAT, data = cps2016)
model_without_wkstat <- update(model_with_wkstat, . ~ . - WKSTAT)

anova(model_without_wkstat, model_with_wkstat)

#doing analysis to show a possible relationship between having a certificate and employment 
labor_force <- subset(cps2016, EMPSTAT %in% c(10, 12, 21, 22)) #10 in the codebook signifies employed, 12 in the codebook signifies has a job but hasn't worked in a week (so still employed), 21 and 22 are both considered unemployed (but still in the labor force)

labor_force$employed <- ifelse(labor_force$EMPSTAT %in% c(10, 12), 1, 0) #I did all of this because EMPSTAT was a categorical variable so if I kept it as a categorical variable it would mess up any further analysis. 

model_full <- glm(employed ~ cert2 + EDUC + AGE + SEX, data = labor_force, family = "binomial") 
#the demographic variables are held constant in this case, PROFCERT is the main variable
summary(model_full)

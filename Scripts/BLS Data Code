#for this graph I will be comparing, white people who have certifications with minorities (black, asian, and hispanic people) who also have certifications 

section_name <- "Race and Hispanic or Latino Ethnicity"

White <- combined_data[combined_data$section == section_name &
                       combined_data$characteristic == "White, 16 years and over", ]

Black <- combined_data[combined_data$section == section_name &
                       combined_data$characteristic == "Black or African American, 16 years and over", ]

Asian <- combined_data[combined_data$section == section_name &
                       combined_data$characteristic == "Asian, 16 years and over", ]

Hispanic_Latino <- combined_data[combined_data$section == section_name &
                                 combined_data$characteristic == "Hispanic or Latino Ethnicity, 16 years and over", ]

col_name <- "median_weekly_earnings_cert_only"

plot(White$year, White[[col_name]],
     type = "o", col = "blue", pch = 16, lwd = 2,
     ylim = range(c(White[[col_name]],
                    Black[[col_name]],
                    Asian[[col_name]],
                    Hispanic_Latino[[col_name]]),
                  na.rm = TRUE),
     xlab = "Year", ylab = "Median Weekly Earnings ($)",
     main = "Earnings With a Certification by Race/Ethnicity\n2015-2025")

lines(Black$year, Black[[col_name]],
      type = "o", col = "purple", pch = 16, lwd = 2)

lines(Asian$year, Asian[[col_name]],
      type = "o", col = "darkgreen", pch = 16, lwd = 2)

lines(Hispanic_Latino$year, Hispanic_Latino[[col_name]],
      type = "o", col = "orange", pch = 16, lwd = 2)

legend("topleft",
       legend = c("White", "Black", "Asian", "Hispanic or Latino"),
       col = c("blue", "purple", "darkgreen", "orange"), lwd = 2, pch = 16)
       
#this is now comparing if only white people didn't have a certification and minorities had a certification 
plot(White$year, White$median_weekly_earnings_without_cert_or_license,
     type = "o", col = "blue", pch = 16, lwd = 2,
     ylim = range(c(White$median_weekly_earnings_without_cert_or_license,

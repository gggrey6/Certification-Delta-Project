     type = "o", col = "blue", pch = 16, lwd = 2,
     ylim = range(c(men$median_weekly_earnings_cert_only,
                    women$median_weekly_earnings_cert_only),
                  na.rm = TRUE),
     xlab = "Year", ylab = "Median Weekly Earnings ($)",
     main = "Men vs. Women: Earnings With a Certification\n2015-2025")

lines(women$year, women$median_weekly_earnings_cert_only,

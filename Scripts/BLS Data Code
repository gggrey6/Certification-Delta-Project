#Now I'm going to compare white women in the graph below, everyone will have a certification 
section_name <- "Race and Hispanic or Latino Ethnicity"
col_name     <- "median_weekly_earnings_cert_only"

# Add a race column so Women rows know their race
sec <- combined_data[combined_data$section == section_name, ]

is_race_row <- !(sec$characteristic %in% c("Men", "Women")) #the exclamation mark is what makes it the race row, it essentially negates it 

sec$race <- sub(", 16 years and over", "",
                sec$characteristic[is_race_row][cumsum(is_race_row)]) #so this is picking the original race row and then adding a cumulative sum to it, and then it's just getting rid of 16 years and over because everyone is 16 years and over

White <- sec[sec$race == "White" &
             sec$characteristic == "Women", ] #race is the new column while characteristics still stay the same 

Black <- sec[sec$race == "Black or African American" &
             sec$characteristic == "Women", ]

Asian <- sec[sec$race == "Asian" &
             sec$characteristic == "Women", ]

Hispanic_Latino <- sec[sec$race == "Hispanic or Latino Ethnicity" &
                       sec$characteristic == "Women", ]

nrow(White); nrow(Black); nrow(Asian); nrow(Hispanic_Latino)  # each = number of years

plot(White$year, White[[col_name]],
     type = "o", col = "blue", pch = 16, lwd = 2,
     ylim = range(c(White[[col_name]],
                    Black[[col_name]],
                    Asian[[col_name]],
                    Hispanic_Latino[[col_name]]),
                  na.rm = TRUE),
     xlab = "Year", ylab = "Median Weekly Earnings ($)",
     main = "Women's Earnings With a Certification\nby Race/Ethnicity, 2015-2025")

lines(Black$year, Black[[col_name]],
      type = "o", col = "purple", pch = 16, lwd = 2)

lines(Asian$year, Asian[[col_name]],
      type = "o", col = "darkgreen", pch = 16, lwd = 2)

lines(Hispanic_Latino$year, Hispanic_Latino[[col_name]],
      type = "o", col = "orange", pch = 16, lwd = 2)

legend("topleft",
       legend = c("White women", "Black women", "Asian women", "Hispanic or Latino women"),
       col = c("blue", "purple", "darkgreen", "orange"), lwd = 2, pch = 16,
       cex = 0.8)

#now comparing women but now white women don't have a certification 

plot(White$year, White$median_weekly_earnings_without_cert_or_license,
     type = "o", col = "blue", pch = 16, lwd = 2,
     ylim = range(c(White[[col_name]],
                    Black[[col_name]],
                    Asian[[col_name]],
                    Hispanic_Latino[[col_name]]),
                  na.rm = TRUE),
     xlab = "Year", ylab = "Median Weekly Earnings ($)",
     main = "White Women (No Cert) vs. Women of Color (Certified)\n2015-2025")

lines(Black$year, Black[[col_name]],
      type = "o", col = "purple", pch = 16, lwd = 2)

lines(Asian$year, Asian[[col_name]],
      type = "o", col = "darkgreen", pch = 16, lwd = 2)

lines(Hispanic_Latino$year, Hispanic_Latino[[col_name]],
      type = "o", col = "orange", pch = 16, lwd = 2)

legend("topleft",
       legend = c("White women", "Black women", "Asian women", "Hispanic or Latino women"),
       col = c("blue", "purple", "darkgreen", "orange"), lwd = 2, pch = 16,
       cex = 0.8)


```{r}
#License Graphs

plot(trend_men$year, trend_men$median_weekly_earnings_cert_only,
     type = "o", col = "blue", pch = 16, lwd = 2,
     ylim = range(c(trend_men$median_weekly_earnings_cert_only,
                     trend_men$median_weekly_earnings_with_license)),
     xlab = "Year", ylab = "Median Weekly Earnings ($)",
     main = "Median Weekly Earnings for Men (Cert vs License), 2015–2025")

lines(trend_men$year, trend_men$median_weekly_earnings_with_license,
      type = "o", col = "red", pch = 16, lwd = 2)

legend("topleft",
       legend = c("With a Certification", "With a License"),
       col = c("blue", "red"), lwd = 2, pch = 16)

#graph for women
trend_women <- combined_data[combined_data$section == "Age and Sex" &
                   combined_data$characteristic == "Women, 16 years and over", ]

plot(trend_women$year, trend_women$median_weekly_earnings_cert_only,
     type = "o", col = "blue", pch = 16, lwd = 2,
     ylim = range(c(trend_women$median_weekly_earnings_cert_only,
                     trend_women$median_weekly_earnings_with_license)),
     xlab = "Year", ylab = "Median Weekly Earnings ($)",
     main = "Median Weekly Earnings for Women (Cert vs License), 2015–2025")

lines(trend_women$year, trend_women$median_weekly_earnings_with_license,
      type = "o", col = "red", pch = 16, lwd = 2)

legend("topleft",
       legend = c("With a Certification", "With a License"),
       col = c("blue", "red"), lwd = 2, pch = 16)

#men vs women with a license 
plot(trend_women$year, trend_women$median_weekly_earnings_with_license,
     type = "o", col = "blue", pch = 16, lwd = 2,
     ylim = range(c(trend_women$median_weekly_earnings_with_license,
                     trend_men$median_weekly_earnings_with_license)),
     xlab = "Year", ylab = "Median Weekly Earnings ($)",
     main = "Median Weekly Earnings for Men vs Women (with a license), 2015–2025")

lines(trend_men$year, trend_men$median_weekly_earnings_with_license,
      type = "o", col = "red", pch = 16, lwd = 2)

legend("topleft",
       legend = c("Women", "Men"),
       col = c("blue", "red"), lwd = 2, pch = 16)




